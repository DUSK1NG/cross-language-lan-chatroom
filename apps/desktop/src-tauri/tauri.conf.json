{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAN Chat",
  "version": "1.4.0",
  "identifier": "dev.dusk1ng.lanchat",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../../frontend run build",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "visible": false,
        "width": 1200,
        "height": 820,
        "minWidth": 440,
        "minHeight": 500,
        "backgroundColor": "#0d1c2c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../assets/LANChat.ico"
    ]
  }
}
