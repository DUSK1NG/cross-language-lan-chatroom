<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LanChat_WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <ProjectReference Include="..\LanChat.Core\LanChat.Core.csproj" />
    <ProjectReference Include="..\LanChat.Presentation\LanChat.Presentation.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\NativeRuntime.targets" />

  <Target Name="PublishWinUiApplicationResources" AfterTargets="Publish">
    <ItemGroup>
      <_LanChatWinUiPublishResource Include="@(ApplicationDefinition->'$(TargetDir)%(RelativeDir)%(Filename).xbf')">
        <TargetPath>%(ApplicationDefinition.RelativeDir)%(ApplicationDefinition.Filename).xbf</TargetPath>
      </_LanChatWinUiPublishResource>
      <_LanChatWinUiPublishResource Include="@(Page->'$(TargetDir)%(RelativeDir)%(Filename).xbf')">
        <TargetPath>%(Page.RelativeDir)%(Page.Filename).xbf</TargetPath>
      </_LanChatWinUiPublishResource>
      <_LanChatWinUiPublishResource Include="$(ProjectPriFullPath)">
        <TargetPath>$(ProjectPriFileName)</TargetPath>
      </_LanChatWinUiPublishResource>
    </ItemGroup>

    <Error Condition="!Exists('%(_LanChatWinUiPublishResource.FullPath)')"
           Text="缺少必需的 WinUI 发布资源：%(_LanChatWinUiPublishResource.FullPath)" />
    <Copy SourceFiles="@(_LanChatWinUiPublishResource)"
          DestinationFiles="@(_LanChatWinUiPublishResource->'$(PublishDir)%(TargetPath)')"
          SkipUnchangedFiles="true" />

    <ItemGroup>
      <_LanChatWinUiPublishedResource Include="@(_LanChatWinUiPublishResource->'$(PublishDir)%(TargetPath)')" />
      <_LanChatWinUiPublishedResource Include="$(PublishDir)%(Content.Identity)"
                                      Condition="'%(Content.CopyToPublishDirectory)' != '' and '%(Content.CopyToPublishDirectory)' != 'Never'" />
    </ItemGroup>
    <Error Condition="!Exists('%(_LanChatWinUiPublishedResource.FullPath)')"
           Text="WinUI 发布目录缺少必需资源：%(_LanChatWinUiPublishedResource.FullPath)" />
  </Target>
</Project>
